[Unit]
Description=PipeOS control server
After=network-online.target
Wants=network-online.target

# Never stop trying to start. systemd's default is to give up permanently after
# 5 starts in 10 seconds, which turns a burst of early crashes into a robot that
# stays dead until someone SSHes in -- the exact failure this unit exists to
# prevent. The robot should always be coming back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pipepatrol
WorkingDirectory=/home/pipepatrol/PipeOS/server
ExecStart=/home/pipepatrol/PipeOS/server/.venv/bin/python -m pipepatrol

# Where the defect model runs. NOT on this Pi -- the graph and onnxruntime are
# not deployed here at all. deploy.sh rewrites this line with the address of the
# machine that ran the deploy, which is the machine expected to be running
# server/detect-host.py. Empty means detection is simply off, and the robot
# drives and records exactly as it does with no model.
#
# The operator can override this from the console's settings screen without a
# redeploy, and that override outranks this line. See config.detector_url().
Environment=PIPEPATROL_DETECTOR_URL=

# This robot never infers locally, whatever is on its SD card. The deploy
# deletes the graph and uninstalls onnxruntime; this is what stops a graph that
# reappears from putting the Pi back to work. See config.ALLOW_LOCAL_MODEL.
Environment=PIPEPATROL_LOCAL_MODEL=0
# always, not on-failure: a clean exit(0) is still a robot with no control
# server, and there is no case where that is the state we want to leave it in.
Restart=always
RestartSec=3

# SIGINT rather than SIGTERM: the handlers in app.py cut the motors on both, but
# SIGINT is the path exercised every time anyone Ctrl-Cs the server by hand, so
# it is the one that is actually tested.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
