# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
web/dist/
*.local
# tsc incremental caches — machine-specific, rewritten by every build
*.tsbuildinfo

# Runtime data — runs, snapshots, and recordings live here on the Pi
server/data/

# Local-only temporary testing (in-browser robot simulator). Private.
temptest/

# Generated reports. Regenerate with the script that made them, don't commit
# the output -- a checked-in copy audit is wrong the moment anyone edits a word.
audit/

# Editors / OS
.DS_Store
.gstack/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# The exported model. Produced by server/deploy/export-model.py on a laptop and
# copied to the robot by deploy.sh — see MODEL.md. Kept out of git because it is
# a ~120 MB binary regenerated from checkpoint_best_total.pth, and git is the
# wrong place to version a build artefact that large. GitHub rejects it anyway,
# at over the 100 MB file limit.
server/model/*.onnx

# The exception: the robot's model is 43 MB, which git can carry. Committing it
# is what makes a fresh clone deployable — clone, ./deploy.sh, and the Pi
# detects defects, with no checkpoint to find and no export to run.
!server/model/pipe-defects-lite.onnx

# Agent worktrees and session state — local scratch, never part of the repo.
.claude/
